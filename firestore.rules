rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Nested Structure Validation Helpers ---
    function isValidSizeEntry(entry) {
      return entry is map
        && entry.keys().hasAll(['size', 'stock', 'price'])
        && entry.keys().hasOnly(['size', 'stock', 'price'])
        && entry.size is string
        && entry.size.size() >= 1
        && entry.size.size() <= 16
        && entry.stock is int
        && entry.stock >= 0
        && entry.stock <= 100000
        && entry.price is int
        && entry.price >= 0
        && entry.price <= 1000000;
    }

    function isValidKarigarEntry(entry) {
      return entry is map
        && entry.keys().hasAll(['stage', 'karigarName', 'unitOrNote', 'dateGiven'])
        && entry.keys().hasOnly(['stage', 'karigarName', 'unitOrNote', 'dateGiven'])
        && entry.stage is string
        && entry.stage.size() >= 1
        && entry.stage.size() <= 60
        && entry.karigarName is string
        && entry.karigarName.size() >= 1
        && entry.karigarName.size() <= 80
        && entry.unitOrNote is string
        && entry.unitOrNote.size() <= 120
        && entry.dateGiven is string
        && entry.dateGiven.size() <= 20;
    }

    function isValidRawMaterials(rm) {
      return rm is map
        && rm.keys().hasAll(['topFabric', 'colorShade', 'bottomFabric', 'dupattaFabric', 'materialNotes'])
        && rm.keys().hasOnly(['topFabric', 'colorShade', 'bottomFabric', 'dupattaFabric', 'materialNotes'])
        && rm.topFabric is string
        && rm.topFabric.size() <= 120
        && rm.colorShade is string
        && rm.colorShade.size() <= 100
        && rm.bottomFabric is string
        && rm.bottomFabric.size() <= 120
        && rm.dupattaFabric is string
        && rm.dupattaFabric.size() <= 120
        && rm.materialNotes is string
        && rm.materialNotes.size() <= 600;
    }

    // --- Entity Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'department', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'role', 'department', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.role is string
        && data.role == 'staff'
        && data.department is string
        && data.department.size() >= 1
        && data.department.size() <= 60
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInventoryItem(data, itemId, userId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'sku', 'title', 'category', 'location',
          'quantity', 'minThreshold', 'status', 'sizes',
          'lastKarigarName', 'lastKarigarStage', 'lastKarigarDate', 'karigars',
          'rawMaterials', 'notes', 'mediaKey',
          'photoFilter', 'photoAspect', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'sku', 'title', 'category', 'location',
          'quantity', 'minThreshold', 'status', 'sizes',
          'lastKarigarName', 'lastKarigarStage', 'lastKarigarDate', 'karigars',
          'rawMaterials', 'notes', 'mediaKey',
          'photoFilter', 'photoAspect', 'createdAt', 'updatedAt'
        ])
        && data.id is string
        && data.id == itemId
        && data.id.size() >= 1
        && data.id.size() <= 64
        && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && data.sku is string
        && data.sku.size() >= 2
        && data.sku.size() <= 32
        && data.sku.matches('^[A-Z0-9\\-]+$')
        && data.title is string
        && data.title.size() >= 2
        && data.title.size() <= 120
        && data.category is string
        && data.category in ['Cotton Daily', 'Festive Silk', 'Chanderi', 'Anarkali', 'Co-ord Sets']
        && data.location is string
        && data.location.size() >= 1
        && data.location.size() <= 60
        && data.quantity is int
        && data.quantity >= 0
        && data.quantity <= 1000000
        && data.minThreshold is int
        && data.minThreshold >= 0
        && data.minThreshold <= 100000
        && data.status is string
        && data.status in ['in_stock', 'low_stock', 'out_of_stock', 'audit_pending']
        && data.sizes is list
        && data.sizes.size() >= 1
        && data.sizes.size() <= 12
        && isValidSizeEntry(data.sizes[0])
        && data.lastKarigarName is string
        && data.lastKarigarName.size() <= 80
        && data.lastKarigarStage is string
        && data.lastKarigarStage.size() <= 60
        && data.lastKarigarDate is string
        && data.lastKarigarDate.size() <= 20
        && data.karigars is list
        && data.karigars.size() <= 10
        && (data.karigars.size() == 0 || isValidKarigarEntry(data.karigars[0]))
        && isValidRawMaterials(data.rawMaterials)
        && data.notes is string
        && data.notes.size() <= 600
        && data.mediaKey is string
        && data.mediaKey.size() >= 1
        && data.mediaKey.size() <= 200
        && data.photoFilter is string
        && data.photoFilter in ['original', 'crisp', 'warm', 'cool', 'mono', 'contrast']
        && data.photoAspect is string
        && data.photoAspect in ['free', '1:1', '4:3', '16:9', '3:4']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasValidParentUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    // --- Collection: /users/{userId} (PII strictly isolated to owner) ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'department', 'updatedAt']);

      allow delete: if isVerified()
        && isValidId(userId)
        && isOwner(userId);

      // --- Subcollection: /users/{userId}/inventory/{itemId} ---
      match /inventory/{itemId} {
        allow get: if isValidId(userId)
          && isValidId(itemId)
          && isOwner(userId)
          && resource.data.ownerId == request.auth.uid
          && hasValidParentUser(userId);

        // Cost-optimized owner-enforced list query (no get()/exists() in list)
        allow list: if isOwner(userId)
          && resource.data.ownerId == request.auth.uid;

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(itemId)
          && isOwner(userId)
          && isValidInventoryItem(incoming(), itemId, userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasValidParentUser(userId);

        allow update: if isVerified()
          && isValidId(userId)
          && isValidId(itemId)
          && isOwner(userId)
          && isValidInventoryItem(incoming(), itemId, userId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Action 1: Per-size stock & pricing ledger update
            incoming().diff(existing()).affectedKeys().hasOnly(['sizes', 'quantity', 'status', 'updatedAt']) ||
            // Action 2: Karigar handover & outsourced craft stage update
            incoming().diff(existing()).affectedKeys().hasOnly([
              'lastKarigarName', 'lastKarigarStage', 'lastKarigarDate', 'karigars', 'updatedAt'
            ]) ||
            // Action 3: Raw materials & fabric notes update
            incoming().diff(existing()).affectedKeys().hasOnly(['rawMaterials', 'updatedAt']) ||
            // Action 4: Full garment design, size pricing, karigar, raw materials & photo update
            incoming().diff(existing()).affectedKeys().hasOnly([
              'sku', 'title', 'category', 'location', 'quantity', 'minThreshold',
              'status', 'sizes', 'lastKarigarName', 'lastKarigarStage', 'lastKarigarDate',
              'karigars', 'rawMaterials', 'notes', 'mediaKey', 'photoFilter', 'photoAspect', 'updatedAt'
            ])
          )
          && hasValidParentUser(userId);

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(itemId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid
          && hasValidParentUser(userId);
      }
    }
  }
}
